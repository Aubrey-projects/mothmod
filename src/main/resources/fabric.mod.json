{
	"schemaVersion": 1,
	"id": "mothmod",
	"version": "${version}",
	"name": "Moth Mod",
	"description": "This mod by Aubrey Jensen adds moths to Minecraft 26.X",
	"authors": [
		"Aubrey Jensen"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Aubrey-projects/mothmod"
	},
	"license": "MIT-License",
	"icon": "assets/mothmod/icon.png",
	"environment": "*",
	"entrypoints": {
